<Window x:Class="FormQiangTu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL 枪战突击修改版" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F28" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <!-- 蓝色主色调（遵守 PCL 许可要求：界面主要色相为蓝色） -->
        <SolidColorBrush x:Key="主蓝" Color="#FF3B82F6" />
        <SolidColorBrush x:Key="深蓝" Color="#FF1E3A5C" />
        <SolidColorBrush x:Key="卡片底" Color="#FF232834" />
        <SolidColorBrush x:Key="文字主" Color="#FFE8ECF5" />
        <SolidColorBrush x:Key="文字次" Color="#FF8B94AD" />

        <Style x:Key="主按钮" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource 主蓝}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5B9CFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF2A3145" />
                                <Setter Property="Foreground" Value="#FF6B7488" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="次按钮" TargetType="Button" BasedOn="{StaticResource 主按钮}">
            <Setter Property="Background" Value="#FF2C3346" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,14">
            <TextBlock Text="🔫 PCL 枪战突击修改版" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource 文字主}" />
            <TextBlock Text="  第三方基于 PCL 的二次创作 · 原项目作者 龙腾猫跃"
                       FontSize="12" Foreground="{StaticResource 文字次}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：版本列表 -->
            <Border Grid.Column="0" Background="{StaticResource 卡片底}" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📦 版本列表" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource 文字主}" Margin="6,2,0,10" />
                    <ListBox x:Name="LstVersion" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF1E2430" CornerRadius="8" Margin="2,3" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding 标题}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource 文字主}" />
                                            <TextBlock Text="{Binding 副标题}" FontSize="11"
                                                       Foreground="{StaticResource 文字次}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding 状态}" FontSize="12"
                                                   Foreground="#FF4ADE80" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：操作 + 模组 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnDownload" Content="⬇ 下载选中版本" Style="{StaticResource 主按钮}" Margin="0,0,8,0" />
                    <Button x:Name="BtnLaunch" Content="▶ 开始游戏" Style="{StaticResource 主按钮}" Margin="0,0,8,0" />
                    <Button x:Name="BtnDelete" Content="🗑 删除" Style="{StaticResource 次按钮}" Margin="0,0,8,0" />
                    <Button x:Name="BtnRefresh" Content="🔄 刷新" Style="{StaticResource 次按钮}" />
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="LabStatus" Text="正在读取版本清单…"
                           Foreground="{StaticResource 文字次}" FontSize="12" Margin="2,0,0,10" />

                <Border Grid.Row="2" Background="{StaticResource 卡片底}" CornerRadius="10" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="🧩 模组（下到选中版本的 mode\模组\）"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource 文字主}"
                                   Margin="6,2,0,10" />
                        <ListBox x:Name="LstMod" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E2430" CornerRadius="8" Margin="2,3" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding 名字}" FontSize="14"
                                                           Foreground="{StaticResource 文字主}" />
                                                <TextBlock Text="{Binding 说明}" FontSize="11"
                                                           Foreground="{StaticResource 文字次}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="下载" Tag="{Binding}"
                                                    Style="{StaticResource 次按钮}" Padding="12,5" FontSize="12"
                                                    Click="BtnModDownload_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部进度 -->
        <StackPanel Grid.Row="2" Margin="2,14,2,0">
            <ProgressBar x:Name="BarProgress" Height="6" Minimum="0" Maximum="1"
                         Background="#FF2A3145" Foreground="{StaticResource 主蓝}" BorderThickness="0" />
            <TextBlock x:Name="LabProgress" Text="" FontSize="11"
                       Foreground="{StaticResource 文字次}" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
