<!-- ============================================================================
     PCL 枪战突击修改版 · 主窗口（FormQiangTu.xaml）

     美术完全沿用 PCL：MyButton / MyScrollViewer 这些控件 + PCL 的 ColorBrush* 主题色与字体，
     排版照 PCL 启动页（左列表 + 右内容）。业务逻辑（清单/下载/解压/账号/模组）全在 ModQiangTu，
     是本项目自己的代码，不调用 PCL 的下载/MC 逻辑。
     ============================================================================ -->
<Window x:Class="FormQiangTu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL"
        Title="PCL 枪战突击修改版" Height="720" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBrushBg1}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶栏：标题 + 账号 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="枪战突击" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                <TextBlock Text="  PCL 修改版" FontSize="12" Margin="6,0,0,0"
                           Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Bottom" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="账号" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource ColorBrushGray2}" />
                <ComboBox x:Name="CmbAccount" Width="170" Height="30" FontSize="13"
                          VerticalContentAlignment="Center" />
                <local:MyButton x:Name="BtnAccAdd" Text="新增" Height="30" Margin="8,0,0,0" MinWidth="58" />
                <local:MyButton x:Name="BtnAccEdit" Text="编辑" Height="30" Margin="6,0,0,0" MinWidth="58" />
            </StackPanel>
        </Grid>

        <!-- 左：版本列表 -->
        <Border Grid.Row="2" Grid.Column="0" CornerRadius="7" Background="{DynamicResource ColorBrushBg0}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="版本列表" FontSize="14" FontWeight="Bold" Margin="6,4,0,8"
                           Foreground="{DynamicResource ColorBrush1}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanVersionList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右：详情 + 模组 -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="7" Background="{DynamicResource ColorBrushBg0}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LabVerTitle" Text="请选择版本" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabVerInfo" Text="左边点一个版本，右边这里显示详情"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <local:MyButton x:Name="BtnLaunch" Text="启动游戏" Height="42" MinWidth="120" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDownload" Text="下载" Height="42" Margin="10,0,0,0" MinWidth="80" />
                        <local:MyButton x:Name="BtnDelete" Text="删除" Height="42" Margin="10,0,0,0" MinWidth="80" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="7" Background="{DynamicResource ColorBrushBg0}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="6,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模组" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="LabModHint" FontSize="11.5"
                                   Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanModList" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="LabStatus" Text="正在读取版本清单…" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefresh" Text="刷新" Height="30" MinWidth="70" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底：进度 + 关于 -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="2,10,2,0">
            <ProgressBar x:Name="BarProgress" Height="5" Minimum="0" Maximum="1"
                         Background="{DynamicResource ColorBrushGray5}"
                         Foreground="{DynamicResource ColorBrush3}" BorderThickness="0" />
            <TextBlock x:Name="LabProgress" Text="" FontSize="11" Margin="0,5,0,0"
                       Foreground="{DynamicResource ColorBrushGray2}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrushGray3}">
                <Run Text="本软件是第三方基于 Plain Craft Launcher 2 (PCL) 独立进行二次创作的产物，与 PCL 官方无关。" />
                <LineBreak />
                <Run Text="原项目作者：龙腾猫跃　赞助支持原作者：" />
                <Hyperlink NavigateUri="https://afdian.net/@LTCat" RequestNavigate="关于_赞助链接">
                    <Run Text="afdian.net/@LTCat" Foreground="{DynamicResource ColorBrush3}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
